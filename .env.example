# ============================================================================
# InterviewReady — Environment Variables
# ============================================================================
# For Coolify (Dockerfile Build Pack): set these in Coolify → App → Environment tab.
# For local dev: copy this to .env and fill in your values.
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────
# COOLIFY: Create a separate PostgreSQL resource first, then copy the
# Internal URL here. It looks like:
#   postgresql://USER:PASS@HOST:5432/interviewready?schema=public
#
# The Docker entrypoint auto-runs migrations + seeds on first startup.
# Without this, the API starts but signup/login will fail (no database).
#
DATABASE_URL=postgresql://irapp:irlocaldev123@localhost:5432/interviewready?schema=public

# ─── App ─────────────────────────────────────────────────────────────────
# The port your app is accessible at (default: 80 = standard HTTP).
# Coolify handles this for you — don't change it.
APP_PORT=80

# ─── Security ────────────────────────────────────────────────────────────
# JWT_SECRET: A long random string used to encrypt login tokens.
# IMPORTANT: Change this in production! Use a random 64+ character string.
# You can generate one at https://www.grc.com/passwords.htm
# Or just mash your keyboard for 60+ characters — anything works.
#
# COOLIFY: Set this in the Environment tab. Use a strong random string.
# Example: a8f3b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0
#
JWT_SECRET=change-me-to-something-long-and-random-in-production

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Needed for "Forgot Password" emails to work.
# Sign up free at https://resend.com — 100 emails/day free.
# Leave the placeholder if you don't need password reset emails yet.
# The app will start fine without RESEND_API_KEY — it only crashes if
# someone actually tries to use "Forgot Password" (and even then it won't
# crash the server, it just logs an error).
#
# COOLIFY: Set in Environment tab. Can be left empty if you don't need
# password reset emails yet.
#
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@interviewready.app

# ─── Frontend URL ────────────────────────────────────────────────────────
# Used for CORS and password reset links.
# Change to your real domain when you have one.
#
# COOLIFY: Set this to the domain Coolify assigned to your app.
# Example: https://abc123.95.216.19.44.sslip.io
# Or your custom domain: https://interviewready.yourdomain.com
#
FRONTEND_URL=http://localhost

# ─── Admin Account ───────────────────────────────────────────────────────
# These create the admin user on first deploy.
# IMPORTANT: Change the password! This is your admin login.
#
# COOLIFY: Set these in the Environment tab before first deploy.
# The admin user is created automatically on first container startup.
# After that, changing these env vars won't change the existing admin.
#
ADMIN_EMAIL=admin@interviewready.app
ADMIN_PASSWORD=ChangeMe123!
